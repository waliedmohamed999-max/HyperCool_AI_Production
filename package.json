{
  "name": "hypercool-ai-production",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node app.cjs",
    "build": "node --check app.cjs && node --check src/server.js && node --check src/application.js",
    "workflows:build": "npm run build",
    "test": "node --test",
    "test:ui": "node scripts/ui-qa.mjs",
    "ui:screenshots": "node scripts/ui-baseline.mjs",
    "agents:extract": "node scripts/extract-agents.js",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "production:check": "node scripts/production-check.mjs",
    "load:workspace-creation": "node scripts/load-workspace-creation.mjs",
    "pilot:isolation-check": "node scripts/data-isolation-check.mjs"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.63.0"
  }
}
