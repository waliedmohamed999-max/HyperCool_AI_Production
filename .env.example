# Copy to .env locally. Never commit real credentials.
#
# Nothing in this file is REQUIRED_FOR_CORE — the app boots and the CRM/content/team
# modules work fully with every variable below unset. Each section is
# REQUIRED_FOR_OPTIONAL_INTEGRATION: leaving it empty just keeps that integration's tools
# honestly reporting INTEGRATION_REQUIRED instead of pretending to work. The app validates
# this at startup and logs exactly what's missing — it never crashes on a missing var.

# ==================================================
# Application
# ==================================================
# Exact HTTPS origin when hosted publicly (e.g. https://app.hyper-cool.com). Leave empty for
# localhost-only access — this also controls whether the session cookie gets the Secure flag.
PUBLIC_ORIGIN=
PORT=3000
# Optional bind address; defaults to 0.0.0.0 when PUBLIC_ORIGIN is set, else 127.0.0.1.
HOST=
# Persistent absolute directory for the SQLite database — must live OUTSIDE any deployment
# release/build folder that gets wiped or replaced on each deploy.
DATA_DIR=
# Launch-safety cap (see DEPLOYMENT.md). PRODUCTION_SAFE forces every agent to run at L1
# regardless of its stored autonomy level, without touching that stored level. Any other
# value (or unset) leaves autonomy uncapped — set this explicitly for a first production
# launch, then raise it once agents have a clean run history.
SYSTEM_MODE=

# ==================================================
# Feature flags (src/runtime/feature-flags.js) — see DEPLOYMENT.md section 8. A second,
# cross-platform layer of BACKEND enforcement, independent of SYSTEM_MODE and of any single
# integration's own credentials. Each accepts exactly 'true' or 'false'; anything else falls
# back to its default. The first four default ON (unset = every already-configured,
# already-tested integration keeps working) — set them to 'false' explicitly for a genuine
# first safe-launch day. The autonomy pair defaults OFF (see below) and cannot be bypassed by
# an owner's UI action alone.
# ==================================================
# Phase 5 controlled pilot: set ENABLE_EXTERNAL_MESSAGING/ENABLE_EXTERNAL_PUBLISHING/
# ENABLE_AUTOMATED_FOLLOWUPS to 'false' EXPLICITLY for the initial pilot rollout — none of the
# three defaults to false on their own (see docs/PILOT_RUNBOOK.md's "External Action
# Enablement Order"). ENABLE_L2_AUTONOMY/ENABLE_L3_AUTONOMY already default OFF below and need
# no action.
# Blocks whatsapp_send and the immediate-send path of microsoft_sendEmail (drafting an
# approval request is never blocked by this — only a real, immediate send is).
ENABLE_EXTERNAL_MESSAGING=
# Blocks meta_publish/x_publish/linkedin_publish outright, regardless of approval/schedule state.
ENABLE_EXTERNAL_PUBLISHING=
# Blocks the internal scheduler from ever triggering the Publishing agent for a due, approved
# calendar item — the item still becomes READY_FOR_CONNECTOR (visible in the calendar), it
# just never fires CONTENT_PUBLISH_REQUESTED while this is off.
ENABLE_SCHEDULED_PUBLISHING=
# Blocks the scheduler's automatic follow-up-gap sweep; manual follow-up creation is unaffected.
ENABLE_AUTOMATED_FOLLOWUPS=
# Defaults OFF. Even an owner's otherwise-valid, one-step promotion to L2 via the Team/Agents
# UI (or POST /api/agents/:id/autonomy) is refused with a clear error until this is 'true'.
ENABLE_L2_AUTONOMY=
# Same as above, for L3. Set only after real evidence from an agent's L2 run history.
ENABLE_L3_AUTONOMY=

# Phase 6F — reserved for a future phase. Defaults OFF ('false'/unset). Setting this to 'true'
# does NOT currently unlock anything real: no tenant-facing custom-connector creation endpoint,
# Draft->Review->Approve workflow, or per-tenant limit/policy enforcement exists yet — see
# docs/TENANT_CUSTOM_CONNECTORS.md for the deferred design. Only a Platform Admin can create a
# connector today (the Integration Builder, #platform).
ENABLE_TENANT_CUSTOM_CONNECTORS=

# ==================================================
# AI Provider — see docs/AI_PROVIDER_SETUP.md
# ==================================================
# Two real, independently-usable providers exist (src/runtime/llmProvider.js). AI_PROVIDER
# picks the ACCOUNT DEFAULT used by every agent unless that specific agent has its own
# provider/model override set via POST /api/agents/:id/model-config (owner only) — see the
# setup doc for why you'd want that (e.g. pinning compliance to a specific low-temperature
# model). Leave AI_PROVIDER unset to default to anthropic.
AI_PROVIDER=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Set an exact model ID available in your Anthropic account.
ANTHROPIC_MODEL=
# Optional generic-provider override; falls back to ANTHROPIC_API_KEY/ANTHROPIC_MODEL above
# when AI_PROVIDER is anthropic (the default) and unset.
AI_API_KEY=
AI_DEFAULT_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=
# Set an exact model ID available in your OpenAI account (must support tool/function calling).
OPENAI_DEFAULT_MODEL=
# Optional — used only by the generate_visual_asset agent tool's real image-generation action
# (POST /v1/images/generations). Defaults to gpt-image-1 if unset. This call has never been
# exercised against a live OpenAI account from this codebase — verify it yourself first, see
# docs/AI_IMAGE_GENERATION.md.
OPENAI_IMAGE_MODEL=

# Off by default. When 'true', a run that fails on the primary provider (network error, rate
# limit, invalid response — NOT a schema-validation failure, which is retried on the SAME
# provider first) retries once on the other configured provider before failing the run.
# Requires BOTH providers configured; otherwise this has no effect regardless of the value.
AI_PROVIDER_FALLBACK_ENABLED=

# ==================================================
# Salla (Commerce) — see docs/SALLA_INTEGRATION_SETUP.md
# ==================================================
# Two ways to authenticate — pick ONE, OAuth takes priority over the static token whenever
# both are present (src/runtime/salla-oauth.js resolveSallaAccessToken):
#
# 1) Static personal/store access token (simplest, single-store, manual rotation):
SALLA_ACCESS_TOKEN=
#
# 2) OAuth app (multi-merchant capable, auto-refreshing) — all three required together:
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=
# Required only if using Salla OR Meta OAuth below: a 32-byte key (64 hex chars, or base64)
# used to encrypt every integration's stored OAuth tokens at rest — shared across
# providers, not per-integration. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never reuse this key across environments; rotating it invalidates every stored OAuth
# token (reconnect each integration via the Integrations page afterward).
INTEGRATION_ENCRYPTION_KEY=

# Real webhook receiver at POST /api/webhooks/salla. Set this to the same secret configured
# in your Salla Partner Portal app's webhook settings.
SALLA_WEBHOOK_SECRET=
SALLA_WEBHOOK_STRATEGY=
SALLA_WEBHOOK_SIGNATURE_HEADER=

# ==================================================
# Zid (Saudi e-commerce platform) — see docs/ZID_CONNECTOR.md
# ==================================================
# OAuth2 Authorization Code app, registered in the Zid Partner Dashboard
# (https://partner.zid.sa) — all three required together. Reuses
# INTEGRATION_ENCRYPTION_KEY above for token-at-rest encryption (no separate key).
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_REDIRECT_URI=

# ==================================================
# Meta (WhatsApp Business / Instagram / Facebook) — see docs/META_INTEGRATION_SETUP.md
# and docs/WHATSAPP_BUSINESS_SETUP.md
# ==================================================
# OAuth app connection (Facebook Login for Business) — resolves the connected Page,
# Instagram Business Account and WhatsApp Business Account automatically once authorized
# via the Integrations page. All three required together for the "Connect Meta" button.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Real webhook receiver at POST /api/webhooks/meta/whatsapp (shared by WhatsApp/Instagram/
# Facebook — one Meta App subscription). META_VERIFY_TOKEN is the value Meta's GET
# verification handshake must send back; META_WEBHOOK_SECRET (falls back to
# META_APP_SECRET if unset) verifies the X-Hub-Signature-256 header on every POST.
META_VERIFY_TOKEN=
META_WEBHOOK_SECRET=

# Legacy static-token alternative to full OAuth (simpler, single-number, manual rotation) —
# OAuth above takes priority whenever both are configured.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Only needed if NOT using OAuth (which resolves these automatically): the specific Page
# and Instagram Business Account to publish to.
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ==================================================
# Microsoft 365 (Email + Calendar) — see docs/MICROSOFT_365_SETUP.md
# ==================================================
# OAuth app (Azure AD / Entra ID app registration) — all three required together for the
# "Connect Microsoft 365" button. MICROSOFT_TENANT_ID may be a specific tenant GUID,
# 'organizations' (any work/school account — the default if unset), or 'common'.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=
# Set to 'true' to also request Calendars.Read/Calendars.ReadWrite at connect time (only
# needed if you want create_calendar_event/get_calendar_availability to work). Off by
# default — least-privilege: don't request calendar access you don't use.
MICROSOFT_ENABLE_CALENDAR=

# Real webhook receiver at POST /api/webhooks/microsoft/mail — a Graph "change
# notification" subscription (created via POST /api/integrations/microsoft/subscribe once
# connected, not automatic). MICROSOFT_WEBHOOK_SECRET is the `clientState` value Graph
# echoes back on every notification — this app's actual verification mechanism (Microsoft
# has no body-signature scheme like Meta's).
MICROSOFT_WEBHOOK_SECRET=
# Override only if your tenant requires a sovereign/government Graph endpoint
# (e.g. https://graph.microsoft.us). Defaults to the global https://graph.microsoft.com/v1.0.
MICROSOFT_GRAPH_BASE_URL=

# Legacy static-token alternative to full OAuth (a pre-acquired token, manual rotation) —
# OAuth above takes priority whenever both are configured.
MICROSOFT_ACCESS_TOKEN=

# ==================================================
# X (Twitter) — see docs/X_INTEGRATION_SETUP.md
# ==================================================
# OAuth 2.0 + PKCE app — X's API v2 REQUIRES PKCE for every client, unlike the other OAuth
# integrations above; the code_verifier/code_challenge are generated and matched internally
# (src/runtime/x-oauth.js), nothing extra to configure here for that. All three required
# together for the "Connect X" button.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
# Read-only app-only Bearer token (from the X Developer Portal's "Keys and tokens" tab) —
# useful for get_x_metrics-style reads and the Integrations page's connectivity test, but
# CANNOT publish: X's POST /2/tweets endpoint requires the OAuth user-context token above.
# Publishing always needs "Connect X" — this alone never enables x_publish.
X_BEARER_TOKEN=

# ==================================================
# LinkedIn — see docs/LINKEDIN_INTEGRATION_SETUP.md
# ==================================================
# OAuth 2.0 app — all three required together for the "Connect LinkedIn" button. Publishing
# to a Company Page additionally requires your app to be approved for the "Community
# Management API" product (w_organization_social/r_organization_social/rw_organization_admin)
# — see the setup doc; a connection without that approval still succeeds as identity-only.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Legacy static-token alternative to full OAuth (a pre-acquired token, manual rotation) —
# OAuth above takes priority whenever both are configured. LinkedIn has no equivalent of
# Meta's "list my Pages" for a static token, so the Company Page must be supplied explicitly.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# Off by default. When 'true', x_publish/linkedin_publish rehearse the full validation/
# approval/scheduling/agent path and return {testMode:true, would_publish:true, payload}
# WITHOUT ever calling the real X/LinkedIn API or marking content published — see Part AX
# of the integration spec / docs/X_INTEGRATION_SETUP.md. Meta publishing is unaffected.
SOCIAL_PUBLISHING_TEST_MODE=

# ==================================================
# Canva — a real OAuth2+PKCE identity/health-check connector exists (src/runtime/canva-oauth.js),
# same shape as X below. The canva_generateAsset agent TOOL still always returns
# {status:"INTEGRATION_REQUIRED"} regardless of these — no confirmed Canva API call exists for
# "generate a visual asset from a brief" yet (see docs/CANVA_CONNECTOR.md). Get these from your
# own Canva Developer Portal app; this flow has never been exercised against a live Canva app
# from this codebase — verify it yourself before relying on it.
# ==================================================
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# ==================================================
# Automation (optional external trigger for /api/automation/* — see docs/planning-and-automation.md)
# ==================================================
# The internal scheduler (src/runtime/scheduler.js) already runs the daily brief, weekly
# report, and follow-up sweep on its own as long as the Node process stays up — these two
# endpoints are only an OPTIONAL redundant/alternative trigger for deployments that cannot
# guarantee a long-running process. Any HTTP caller works (cron, Windows Task Scheduler,
# a manual curl, or a workflow tool) — none is required or assumed.
# Random secret, at least 32 characters, shared only with your own automation caller.
AUTOMATION_TOKEN=

# ==================================================
# Self-Service Signup + Workspace Creation (Multi-Tenant Phase 4C-6)
# see docs/SELF_SERVICE_SIGNUP.md / docs/WORKSPACE_CREATION.md / docs/TRIAL_WORKSPACES.md
# ==================================================
# Platform-level switch for self-service NEW WORKSPACE creation (never gates public account
# signup itself — that stays open). Defaults to 'true' (enabled) — set to 'false' to disable.
ALLOW_SELF_SERVICE_WORKSPACE_CREATION=
# How many workspaces one verified user can create for THEMSELVES (an owner membership gained
# through accepting someone else's invitation never counts against this). Defaults to 1.
SELF_SERVICE_MAX_OWNED_WORKSPACES=
# Trial length in days for a newly self-created workspace. Defaults to 14.
TRIAL_DAYS=

# ==================================================
# Production Pilot Hardening (Multi-Tenant Phase 4C-7) — see docs/PILOT_RUNBOOK.md
# ==================================================
# There is no separate PILOT_MODE flag — ALLOW_PUBLIC_SIGNUP and
# ALLOW_SELF_SERVICE_WORKSPACE_CREATION already give independent, granular control over the
# two real gates a pilot needs (invite-only accounts vs. invite-only workspaces), without a
# third flag that could conflict with either. Set 'false' to close public account registration
# outright — existing users and invitation registration are completely unaffected either way.
# Phase 5 controlled pilot: recommended initial value is 'false' (invite-only) — this does NOT
# default to false on its own (unset behaves as open/true). Only consider 'true' + a configured
# CAPTCHA_PROVIDER once the first controlled tenant is stable.
ALLOW_PUBLIC_SIGNUP=
# Conservative pilot-scale abuse limits (Part 4) — every one is OFF (no cap) unless set to a
# positive integer; none replaces the existing per-IP rate limiters, each is an ADDITIONAL
# safety valve tuned for running a small number of real pilot companies.
MAX_TOTAL_TRIAL_WORKSPACES=
MAX_SIGNUPS_PER_HOUR=
MAX_WORKSPACES_PER_IP_PER_DAY=
# Bot protection (Part 5-9) — see docs/PILOT_RUNBOOK.md's CAPTCHA section. Leave
# CAPTCHA_PROVIDER empty and this whole layer reports DISABLED and verifies every request as
# passing automatically (no behavior change for a deployment that never asked for this).
# Only real supported value today: 'turnstile' (Cloudflare Turnstile — a plain HTTPS API, no
# SDK dependency).
CAPTCHA_PROVIDER=
TURNSTILE_SECRET_KEY=
# Per-surface requirement once a provider IS configured: signup defaults to required; the two
# "optional" surfaces default OFF until explicitly set to 'true'.
CAPTCHA_REQUIRE_SIGNUP=
CAPTCHA_REQUIRE_FORGOT_PASSWORD=
CAPTCHA_REQUIRE_WORKSPACE_CREATION=
# Platform Admin (Part 20) — a minimal, explicit allowlist of real usernames, comma-separated.
# NOT the same as any tenant's own 'owner' role — a platform admin can inspect/suspend/
# reactivate/extend-trial ANY tenant on this deployment via #platform, regardless of their own
# workspace memberships. Leave empty and #platform is unreachable for everyone.
PLATFORM_ADMIN_USERNAMES=
# Standard Node convention this codebase did not previously read anywhere — now used to gate
# the CAPTCHA development bypass (Part 9) and checked by `npm run production:check`
# (scripts/production-check.mjs). Set to 'production' for any real deployment.
NODE_ENV=

# ==================================================
# Platform Mail (Multi-Tenant Phase 4C-5) — see docs/PLATFORM_EMAIL.md
# ==================================================
# Sends account verification / password reset / workspace invitation mail ON BEHALF OF
# HYPERCOOL ITSELF — completely separate from any tenant's own Microsoft 365 connection.
# Leave both empty and these features honestly report UNCONFIGURED (never crash the app).
# A real transport: Resend (https://resend.com) — a plain HTTPS API, one API key.
PLATFORM_RESEND_API_KEY=
# The exact "From" address/name Resend will send as (must be a domain verified in Resend).
PLATFORM_MAIL_FROM=
# Development/test only — set to 'capture' to record the full rendered message (including
# the real verification/reset/invite link) into the platform_mail_outbox table instead of
# making any real network call. NEVER set this in a real deployment.
PLATFORM_MAIL_TRANSPORT=

# ==================================================
# Not applicable to this codebase (documented so you don't go looking for them)
# ==================================================
# DATABASE_URL      — there is no separate DB server; storage is a single SQLite file at
#                      DATA_DIR/hypercool.sqlite (WAL mode). DATA_DIR above is the real
#                      equivalent of a connection string here.
# AUTH_SECRET /
# SESSION_SECRET     — sessions are random tokens hashed and stored server-side (not
#                      signed JWTs), so there is no secret to configure.
# REDIS_URL           — no queue/cache layer exists; scheduled work runs in-process
#                      (see SCHEDULER_INTERVAL_MS below).
# STORAGE_*           — no file/object upload feature exists yet.
# SENTRY_DSN          — no error-tracking SDK is wired in yet; see RUNBOOK.md for the
#                      integration point if you add one.
# ENCRYPTION_KEY      — the real name is INTEGRATION_ENCRYPTION_KEY (see the Salla/Meta
#                      sections above) — only OAuth-connected integrations' tokens are
#                      ever stored in the database, always encrypted with that key; a
#                      static-token integration (SALLA_ACCESS_TOKEN, WHATSAPP_ACCESS_TOKEN,
#                      etc.) never touches the database at all.

# ==================================================
# Scheduler tuning (optional)
# ==================================================
# Milliseconds between scheduler ticks (daily brief / weekly report / follow-up sweep).
# Defaults to 300000 (5 minutes) if unset.
SCHEDULER_INTERVAL_MS=

# ==================================================
# Partner program (Frost Partners) — see docs/PARTNERS.md
# ==================================================
# Shared secret used to verify billing webhooks (HMAC-SHA256 of the raw body, sent as
# "x-frost-signature: sha256=<hex>") to POST /api/webhooks/partner-billing. Without it the
# endpoint answers 503 and payments can only be recorded manually by a partnerships manager.
PARTNER_BILLING_WEBHOOK_SECRET=
# Partner payout details (bank/PayPal) are stored encrypted with INTEGRATION_ENCRYPTION_KEY (above);
# partners cannot save a payout method until it is set. Program managers are the platform admins
# listed in PLATFORM_ADMIN_USERNAMES plus staff granted per-permission access in the dashboard.

# ==================================================
# Merchant portal (/client) and support mode — see docs/CLIENT_PORTAL.md
# ==================================================
# Optional. Comma-separated usernames that may open support sessions inside a customer workspace.
# When empty, every platform admin (PLATFORM_ADMIN_USERNAMES) may. Support mode never reveals or changes a password.
SUPPORT_ACCESS_USERNAMES=
# Merchant registration reuses ALLOW_PUBLIC_SIGNUP, ALLOW_SELF_SERVICE_WORKSPACE_CREATION, the pilot limits and the
# CAPTCHA settings above. The trial length comes from the plan (client_plans.trial_days), not from TRIAL_DAYS.
# Merchant OAuth reuses the provider app credentials above (SALLA_/ZID_/META_/MICROSOFT_/X_/LINKEDIN_ *_CLIENT_ID|APP_ID and *_SECRET).
# Register {PUBLIC_ORIGIN}/api/client/integrations/<salla|zid|meta|microsoft365|x|linkedin>/callback in each provider console.
# The *_REDIRECT_URI values are only for the operator's own dashboard flow.
