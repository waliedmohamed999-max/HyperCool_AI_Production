# Copy to .env locally. Never commit real credentials.
ANTHROPIC_API_KEY=
# Set an exact model ID available in your Anthropic account.
ANTHROPIC_MODEL=
SALLA_ACCESS_TOKEN=
# Optional: random secret of at least 32 characters for local n8n preparation only.
AUTOMATION_TOKEN=
PORT=3000
# Hosting: exact HTTPS origin; leave empty for localhost-only access.
PUBLIC_ORIGIN=
# Persistent absolute directory outside deployment release folders.
DATA_DIR=
# Optional bind address; defaults to 0.0.0.0 with PUBLIC_ORIGIN, localhost otherwise.
HOST=

# Optional generic LLM provider override; falls back to ANTHROPIC_API_KEY/ANTHROPIC_MODEL above if unset.
AI_PROVIDER=
AI_API_KEY=
AI_DEFAULT_MODEL=

# Agent runtime integrations — leave unset until each account is ready. Tools that need
# these return {status:"INTEGRATION_REQUIRED"} instead of failing when unset.
WHATSAPP_ACCESS_TOKEN=
META_ACCESS_TOKEN=
X_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
MICROSOFT_ACCESS_TOKEN=
CANVA_API_KEY=
SALLA_WEBHOOK_SECRET=
