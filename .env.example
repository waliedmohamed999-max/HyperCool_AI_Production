# Copy to .env locally. Never commit real credentials.
#
# Nothing in this file is REQUIRED_FOR_CORE — the app boots and the CRM/content/team
# modules work fully with every variable below unset. Each section is
# REQUIRED_FOR_OPTIONAL_INTEGRATION: leaving it empty just keeps that integration's tools
# honestly reporting INTEGRATION_REQUIRED instead of pretending to work. The app validates
# this at startup and logs exactly what's missing — it never crashes on a missing var.

# ==================================================
# Application
# ==================================================
# Exact HTTPS origin when hosted publicly (e.g. https://app.hyper-cool.com). Leave empty for
# localhost-only access — this also controls whether the session cookie gets the Secure flag.
PUBLIC_ORIGIN=
PORT=3000
# Optional bind address; defaults to 0.0.0.0 when PUBLIC_ORIGIN is set, else 127.0.0.1.
HOST=
# Persistent absolute directory for the SQLite database — must live OUTSIDE any deployment
# release/build folder that gets wiped or replaced on each deploy.
DATA_DIR=
# Launch-safety cap (see DEPLOYMENT.md). PRODUCTION_SAFE forces every agent to run at L1
# regardless of its stored autonomy level, without touching that stored level. Any other
# value (or unset) leaves autonomy uncapped — set this explicitly for a first production
# launch, then raise it once agents have a clean run history.
SYSTEM_MODE=

# ==================================================
# AI Provider — see docs/AI_PROVIDER_SETUP.md
# ==================================================
# Two real, independently-usable providers exist (src/runtime/llmProvider.js). AI_PROVIDER
# picks the ACCOUNT DEFAULT used by every agent unless that specific agent has its own
# provider/model override set via POST /api/agents/:id/model-config (owner only) — see the
# setup doc for why you'd want that (e.g. pinning compliance to a specific low-temperature
# model). Leave AI_PROVIDER unset to default to anthropic.
AI_PROVIDER=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Set an exact model ID available in your Anthropic account.
ANTHROPIC_MODEL=
# Optional generic-provider override; falls back to ANTHROPIC_API_KEY/ANTHROPIC_MODEL above
# when AI_PROVIDER is anthropic (the default) and unset.
AI_API_KEY=
AI_DEFAULT_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=
# Set an exact model ID available in your OpenAI account (must support tool/function calling).
OPENAI_DEFAULT_MODEL=

# Off by default. When 'true', a run that fails on the primary provider (network error, rate
# limit, invalid response — NOT a schema-validation failure, which is retried on the SAME
# provider first) retries once on the other configured provider before failing the run.
# Requires BOTH providers configured; otherwise this has no effect regardless of the value.
AI_PROVIDER_FALLBACK_ENABLED=

# ==================================================
# Salla (Commerce) — see docs/SALLA_INTEGRATION_SETUP.md
# ==================================================
# Two ways to authenticate — pick ONE, OAuth takes priority over the static token whenever
# both are present (src/runtime/salla-oauth.js resolveSallaAccessToken):
#
# 1) Static personal/store access token (simplest, single-store, manual rotation):
SALLA_ACCESS_TOKEN=
#
# 2) OAuth app (multi-merchant capable, auto-refreshing) — all three required together:
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=
# Required only if using OAuth above: a 32-byte key (64 hex chars, or base64) used to
# encrypt stored OAuth tokens at rest. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never reuse this key across environments; rotating it invalidates any stored OAuth tokens
# (reconnect via the Integrations page afterward).
INTEGRATION_ENCRYPTION_KEY=

# Real webhook receiver at POST /api/webhooks/salla. Set this to the same secret configured
# in your Salla Partner Portal app's webhook settings.
SALLA_WEBHOOK_SECRET=
# Which verification method your Salla app is configured with: 'token' (default — the
# secret sent verbatim, typically in Authorization) or 'signature' (HMAC-SHA256 of the raw
# body). Confirm this against your actual Partner Portal app settings.
SALLA_WEBHOOK_STRATEGY=
# Only used when SALLA_WEBHOOK_STRATEGY=signature; defaults to x-salla-signature.
SALLA_WEBHOOK_SIGNATURE_HEADER=

# ==================================================
# Agent runtime integrations (WhatsApp / Meta / X / LinkedIn / Microsoft 365 / Canva)
# ==================================================
# None of these have a real connector implemented yet — every tool that needs one always
# returns {status:"INTEGRATION_REQUIRED"}, credentials or not. Setting these now costs
# nothing and does not turn on real sending/publishing; they're here so the Integrations
# page's "configured" flags are accurate once real connector code lands.
WHATSAPP_ACCESS_TOKEN=
META_ACCESS_TOKEN=
X_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
MICROSOFT_ACCESS_TOKEN=
CANVA_API_KEY=

# ==================================================
# Automation (optional external trigger for /api/automation/* — see docs/planning-and-automation.md)
# ==================================================
# The internal scheduler (src/runtime/scheduler.js) already runs the daily brief, weekly
# report, and follow-up sweep on its own as long as the Node process stays up — these two
# endpoints are only an OPTIONAL redundant/alternative trigger for deployments that cannot
# guarantee a long-running process. Any HTTP caller works (cron, Windows Task Scheduler,
# a manual curl, or a workflow tool) — none is required or assumed.
# Random secret, at least 32 characters, shared only with your own automation caller.
AUTOMATION_TOKEN=

# ==================================================
# Not applicable to this codebase (documented so you don't go looking for them)
# ==================================================
# DATABASE_URL      — there is no separate DB server; storage is a single SQLite file at
#                      DATA_DIR/hypercool.sqlite (WAL mode). DATA_DIR above is the real
#                      equivalent of a connection string here.
# AUTH_SECRET /
# SESSION_SECRET     — sessions are random tokens hashed and stored server-side (not
#                      signed JWTs), so there is no secret to configure.
# REDIS_URL           — no queue/cache layer exists; scheduled work runs in-process
#                      (see SCHEDULER_INTERVAL_MS below).
# STORAGE_*           — no file/object upload feature exists yet.
# SENTRY_DSN          — no error-tracking SDK is wired in yet; see RUNBOOK.md for the
#                      integration point if you add one.
# ENCRYPTION_KEY      — no integration credentials are stored in the database; they only
#                      ever live in this .env file / host environment.

# ==================================================
# Scheduler tuning (optional)
# ==================================================
# Milliseconds between scheduler ticks (daily brief / weekly report / follow-up sweep).
# Defaults to 300000 (5 minutes) if unset.
SCHEDULER_INTERVAL_MS=
